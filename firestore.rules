rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /voters/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    match /elections/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /candidates/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /votes/{id} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.voterUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.voterUid == request.auth.uid
        && request.resource.data.keys().hasAll(['electionId', 'voterUid', 'candidateId', 'castAt'])
        && id == request.auth.uid + '_' + request.resource.data.electionId;
      allow update, delete: if false;
    }
  }
}
